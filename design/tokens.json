{
  "$description": "Memories design tokens: platform-neutral source of truth (W3C Design Tokens format). Edit here first, then mirror into each implementation.",
  "$implementations": {
    "android-web-ui": "css/app.css (:root)",
    "android-native": "android/app/src/main/res/values/colors.xml, styles.xml",
    "ios": "Assets.xcassets color sets + Theme.swift (v2)"
  },
  "color": {
    "$type": "color",
    "surface": { "$value": "#EDECEA" },
    "surface-container": { "$value": "#E6E3E0" },
    "surface-container-high": { "$value": "#F7F6F4" },
    "dot": { "$value": "#CCC8C2" },
    "on-surface": { "$value": "#111111" },
    "on-surface-variant": { "$value": "#636363" },
    "outline": { "$value": "#8A8580" },
    "outline-variant": { "$value": "#CCC8C2" },
    "primary-container": { "$value": "#F5A742", "$description": "Brand orange" },
    "on-primary-container": { "$value": "#683F00" },
    "primary": { "$value": "#875300" },
    "on-primary": { "$value": "#FFFFFF" },
    "error": { "$value": "#BA1A1A" },
    "inverse-surface": { "$value": "#2B2926" },
    "inverse-on-surface": { "$value": "#F4F2EF" },
    "inverse-primary": { "$value": "#FFB868" },
    "scrim": { "$value": "#000000" },
    "camera": { "$value": "#000000" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Nunito Sans" },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "semibold": { "$value": 600 }
    }
  },
  "typography": {
    "$type": "typography",
    "headline-medium": { "$value": { "fontSize": 28, "lineHeight": 36, "fontWeight": 600 } },
    "headline-small": { "$value": { "fontSize": 24, "lineHeight": 32, "fontWeight": 600 } },
    "title-large": { "$value": { "fontSize": 22, "lineHeight": 28, "fontWeight": 600 } },
    "title-medium": { "$value": { "fontSize": 16, "lineHeight": 24, "fontWeight": 600 } },
    "title-small": { "$value": { "fontSize": 14, "lineHeight": 20, "fontWeight": 600 } },
    "body-large": { "$value": { "fontSize": 16, "lineHeight": 24, "fontWeight": 400 } },
    "body-medium": { "$value": { "fontSize": 14, "lineHeight": 20, "fontWeight": 400 } },
    "body-small": { "$value": { "fontSize": 12, "lineHeight": 16, "fontWeight": 400 } },
    "label-large": { "$value": { "fontSize": 14, "lineHeight": 20, "fontWeight": 600 } },
    "label-medium": { "$value": { "fontSize": 12, "lineHeight": 16, "fontWeight": 600 } }
  },
  "space": {
    "$type": "dimension",
    "1": { "$value": 4 }, "2": { "$value": 8 }, "3": { "$value": 12 }, "4": { "$value": 16 },
    "6": { "$value": 24 }, "8": { "$value": 32 }, "10": { "$value": 40 }, "12": { "$value": 48 }, "16": { "$value": 64 }
  },
  "shape": {
    "$type": "dimension",
    "extra-small": { "$value": 4 }, "small": { "$value": 8 }, "medium": { "$value": 12 },
    "large": { "$value": 16 }, "extra-large": { "$value": 28 }, "full": { "$value": 9999 }
  },
  "object": {
    "$description": "Signature cut-out look (all platforms)",
    "outline-width": { "$type": "dimension", "$value": 2 },
    "outline-color": { "$type": "color", "$value": "#FFFFFF" },
    "shadow": { "$type": "shadow", "$value": { "offsetX": 0, "offsetY": 6, "blur": 18, "color": "#0000001F" } },
    "crop-margin": { "$value": "4%" }
  }
}
