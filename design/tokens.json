{
  "$description": "Memories design tokens: platform-neutral source of truth (W3C Design Tokens format). Edit here first, then mirror into each implementation.",
  "$implementations": {
    "brand-screens": "css/app.css (:root)",
    "android-native": "android/app/src/main/res/values/colors.xml, styles.xml (native.* below)",
    "ios": "Assets.xcassets color sets + Theme.swift (v2)"
  },
  "color": {
    "$type": "color",
    "bg": { "$value": "#EDECEA", "$description": "Warm grey background of every brand screen" },
    "dot": { "$value": "#CCC8C2", "$description": "Dot texture (1px every 28px), progress track" },
    "text": { "$value": "#111111", "$description": "Names, titles, body, icons" },
    "text-secondary": { "$value": "#636363", "$description": "Dates, subtitles, placeholders; 5.1:1 on bg" },
    "line": { "$value": "#0000001A", "$description": "Resting underline of an empty name field" },
    "accent": { "$value": "#F5A742", "$description": "Brand orange: FAB, primary buttons, progress, focused underline" },
    "on-accent": { "$value": "#683F00", "$description": "Text and icons on orange; 4.6:1" },
    "round": { "$value": "#E2DFDB", "$description": "Secondary round buttons" },
    "sticker": { "$value": "#FFFFFF", "$description": "Outline round cut-outs and names" },
    "scrim": { "$value": "#00000073", "$description": "Floating close button (45% black, 6px blur)" },
    "camera": { "$value": "#000000" },
    "on-camera": { "$value": "#FFFFFF" },
    "on-camera-secondary": { "$value": "#A3A3A3" },
    "camera-control": { "$value": "#FFFFFF26", "$description": "Gallery button" },
    "toast": { "$value": "#2B2926", "$description": "Snackbar background" },
    "on-toast": { "$value": "#F4F2EF" },
    "toast-action": { "$value": "#FFB868" },
    "focus": { "$value": "#683F00", "$description": "Keyboard focus ring" }
  },
  "font": {
    "family": { "$type": "fontFamily", "$value": "Nunito Sans" },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "heavy": { "$value": 900 }
    }
  },
  "typography": {
    "$type": "typography",
    "display": { "$value": { "fontSize": 28, "lineHeight": 1.15, "fontWeight": 400, "letterSpacing": -0.5 }, "$description": "Home title" },
    "headline": { "$value": { "fontSize": 28, "lineHeight": 1.15, "fontWeight": 900, "letterSpacing": -0.5 }, "$description": "Object name on review and detail (sticker stroke)" },
    "title": { "$value": { "fontSize": 22, "lineHeight": 1.25, "fontWeight": 900 }, "$description": "Empty-state title, progress %" },
    "label": { "$value": { "fontSize": 15, "lineHeight": 1.2, "fontWeight": 900, "letterSpacing": 0.2 }, "$description": "Grid name (sticker stroke), buttons, processing label" },
    "body": { "$value": { "fontSize": 14, "lineHeight": 1.5, "fontWeight": 400 }, "$description": "Story, descriptions, snackbar" },
    "caption": { "$value": { "fontSize": 13, "lineHeight": 1.4, "fontWeight": 400 }, "$description": "Dates, subtitles" },
    "name-stroke": { "$type": "dimension", "$value": 4, "$description": "White stroke behind object names" }
  },
  "icon": {
    "$type": "dimension",
    "$description": "Material Symbols Rounded, weight 400",
    "default": { "$value": 24 }, "large": { "$value": 32, "$description": "FAB" }, "hero": { "$value": 40, "$description": "Camera-off message" }
  },
  "space": {
    "$type": "dimension",
    "$description": "4px grid. Screen side margin 16.",
    "4": { "$value": 4 }, "8": { "$value": 8 }, "12": { "$value": 12 }, "16": { "$value": 16 },
    "24": { "$value": 24 }, "32": { "$value": 32 }, "40": { "$value": 40 }, "64": { "$value": 64 },
    "screen-margin": { "$value": 16 }
  },
  "shape": {
    "$type": "dimension",
    "large": { "$value": 20, "$description": "Snackbar" },
    "full": { "$value": 9999, "$description": "Buttons, FAB, close" }
  },
  "size": {
    "$type": "dimension",
    "touch-target": { "$value": 48 },
    "close": { "$value": 40, "$description": "Visible circle inside the 48 target" },
    "button": { "$value": 52, "$description": "Primary pill height, secondary round diameter" },
    "fab": { "$value": 56 },
    "shutter": { "$value": 72 },
    "progress": { "$value": 96, "$description": "Ring, 6% stroke" }
  },
  "shadow": {
    "$type": "shadow",
    "accent": { "$value": { "offsetX": 0, "offsetY": 6, "blur": 20, "color": "#F5A74259" }, "$description": "Orange glow under FAB and primary buttons" },
    "toast": { "$value": { "offsetX": 0, "offsetY": 6, "blur": 20, "color": "#0000002E" } }
  },
  "object": {
    "$description": "Signature cut-out look (all platforms): grid, empty state, review, detail",
    "outline-width": { "$type": "dimension", "$value": 2 },
    "outline-color": { "$type": "color", "$value": "#FFFFFF" },
    "shadow": { "$type": "shadow", "$value": { "offsetX": 0, "offsetY": 6, "blur": 18, "color": "#0000001F" } },
    "crop-margin": { "$value": "4%" }
  },
  "motion": {
    "press-scale": { "$value": 0.95, "$description": "Everything tappable shrinks while pressed" },
    "press": { "$type": "duration", "$value": "200ms" },
    "fade": { "$type": "duration", "$value": "250ms", "$description": "Overlays fade in/out; snackbar fades + rises 8px" },
    "easing": { "$type": "cubicBezier", "$value": [0.25, 0.1, 0.25, 1], "$description": "CSS ease" }
  },
  "native": {
    "$description": "Android native theme (Material 3 roles) for system moments: dialogs, sheets, launch screen. Mirrored in res/values/colors.xml.",
    "$type": "color",
    "primary": { "$value": "#875300", "$description": "Dialog buttons, focus (tonal match of the brand orange)" },
    "on-primary": { "$value": "#FFFFFF" },
    "primary-container": { "$value": "#F5A742" },
    "on-primary-container": { "$value": "#683F00" },
    "surface": { "$value": "#EDECEA" },
    "surface-container": { "$value": "#E6E3E0" },
    "surface-container-high": { "$value": "#F7F6F4", "$description": "Dialog background" },
    "on-surface": { "$value": "#111111" },
    "on-surface-variant": { "$value": "#636363" },
    "outline": { "$value": "#8A8580" },
    "outline-variant": { "$value": "#CCC8C2" },
    "error": { "$value": "#BA1A1A", "$description": "Destructive dialog action" }
  }
}
