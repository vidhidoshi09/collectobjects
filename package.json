{
  "name": "memories",
  "version": "1.0.0",
  "private": true,
  "description": "Memories — object collection app (web + Android via Capacitor)",
  "scripts": {
    "start": "browser-sync start --server --files \"index.html, assets/**\" --port 8000 --no-open --no-notify --no-ui",
    "build": "node scripts/build-web.js",
    "sync": "npm run build && cap sync android",
    "open:android": "cap open android",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug",
    "dev:android": "cap run android --live-reload --host localhost --port 8000 --forwardPorts 8000:8000"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "browser-sync": "^3.0.4"
  }
}
